# === REQUIRED ===
DISCORD_BOT_TOKEN=your_discord_bot_token
OPENAI_API_KEY=your_openai_api_key

# === BOT IDENTITY ===
BOT_NAME=MyBot                          # Your bot's name (used in prompts and logs)
BOT_TRIGGER=mybot                       # Word that triggers the bot (defaults to bot's Discord username)
COMMUNITY_NAME=My Server                # Your server/community name (used in system prompt)
COMMUNITY_TOPIC=gaming and good vibes   # What your server is about (used in system prompt)

# === AI MODEL ===
OPENAI_MODEL=gpt-4o                     # OpenAI model (gpt-4o, gpt-4o-mini, gpt-4-turbo, etc.)

# === CONVERSATION ===
CONVERSATION_TIMEOUT=180                # Seconds before bot stops listening in a channel
CHANNEL_HISTORY_LIMIT=10                # Recent messages fetched for context
USER_MEMORY_LIMIT=8                     # Per-user message memory

# === SEARCH ===
SEARCH_MESSAGES_PER_CHANNEL=500         # Messages scanned per channel during search
SEARCH_MAX_RESULTS=5                    # Max search results returned
SEARCH_CHANNEL_IDS=                     # Comma-separated channel IDs to search (empty = all accessible)

# === SUMMARY ===
SUMMARY_MESSAGE_LIMIT=200               # Messages used for channel summaries
SUMMARY_MAX_CHARS=24000                  # Character limit for summary context

# === IMAGE GENERATION ===
IMAGE_MODEL=gpt-image-1                 # OpenAI image model
IMAGE_SPONTANEOUS_CHANCE=0.02           # Chance (0-1) of spontaneous image generation per response

# === OPTIONAL ===
GIPHY_API_KEY=                          # Giphy API key for GIF reactions (leave empty to disable)

# === DATABASE ===
DB_PATH=/data/bot.db                # Persistent DB path (Railway volume or Docker mount)
DB_FALLBACK_PATH=bot.db             # Local fallback if no volume mounted

# === HEALTH CHECK ===
PORT=8080                               # Health endpoint port (Railway sets this automatically)
